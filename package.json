    "@notionhq/client": "^5.21.0",
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^12.10.0",
    "bullmq": "^5.76.8",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
