  "main": "index.js",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src/index.ts",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:dashboard\"",
    "dev:api": "nodemon --watch 'src/**/*.ts' --exec 'ts-node -r tsconfig-paths/register src/index.ts'",
    "dev:dashboard": "cd dashboard && npm run dev",
    "validate": "ts-node -r tsconfig-paths/register src/validate-schema.ts",
    "test:fallback": "ts-node -r tsconfig-paths/register src/test-fallback.ts",
    "test:e2e": "ts-node -r tsconfig-paths/register src/test-e2e.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
